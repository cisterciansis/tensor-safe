{
  "name": "tensor-safe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "tsx tests/core.test.ts && tsx tests/reconciliation.test.ts && python3 tests/ledger.test.py && tsx tests/accrual.test.ts && tsx tests/lease-history.test.ts && tsx tests/controls.test.ts && tsx tests/wallets.test.ts",
    "check": "tsc --noEmit && oxlint",
    "test:api": "tsx tests/api.integration.ts",
    "test:chain": "tsx tests/chain.integration.ts && tsx tests/signature.integration.ts && tsx tests/accrual.integration.ts",
    "db:local": "wrangler d1 execute DB --local --config .openai/local-db.json --persist-to .wrangler/state --file drizzle/0000_special_silver_surfer.sql",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@noble/curves": "1.9.7",
    "@polkadot-api/merkleize-metadata": "^1.3.1",
    "@polkadot/api": "^16.5.6",
    "@polkadot/extension-dapp": "^0.63.1",
    "@polkadot/react-qr": "^3.16.7",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "type": "module",
  "license": "Apache-2.0"
}
