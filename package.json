{
  "name": "tensor-safe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "PORT=8787 tsx watch server/main.ts & vite",
    "build": "vite build && npm run build:server",
    "build:server": "vite build --ssr server/main.ts --outDir dist/server",
    "start": "node dist/server/main.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "tsx tests/core.test.ts && tsx tests/reconciliation.test.ts && python3 tests/ledger.test.py && tsx tests/accrual.test.ts && tsx tests/lease-history.test.ts && tsx tests/controls.test.ts && tsx tests/wallets.test.ts && tsx tests/auth.test.ts && tsx tests/server.test.ts",
    "check": "tsc --noEmit && oxlint",
    "test:chain": "tsx tests/chain.integration.ts && tsx tests/signature.integration.ts && tsx tests/accrual.integration.ts",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@polkadot-api/merkleize-metadata": "^1.3.1",
    "@polkadot/api": "^16.5.6",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "postgres": "3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@polkadot/extension-dapp": "^0.63.1",
    "@polkadot/react-qr": "^3.16.7",
    "@shadcn/react": "0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module",
  "license": "Apache-2.0"
}
